{
  "name": "eschool-smoke-test",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js homework bot with a one-time server-side Classroom cookie capture mode",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "start": "node src/index.js",
    "sync": "node --disable-warning=ExperimentalWarning src/sync-cli.js",
    "bot": "node --disable-warning=ExperimentalWarning src/bot-cli.js",
    "classroom:auth": "node --disable-warning=ExperimentalWarning src/classroom-auth-cli.js",
    "classroom:smoke": "node --disable-warning=ExperimentalWarning src/classroom-smoke-cli.js",
    "classroom:courses:smoke": "node --disable-warning=ExperimentalWarning src/classroom-courses-smoke-cli.js",
    "eschool:session:diagnostic": "node --disable-warning=ExperimentalWarning src/eschool-session-diagnostic-cli.js",
    "telegram:test": "node src/telegram-check.js",
    "benchmark:neon": "node scripts/neon-optimization-benchmark.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "cheerio": "1.0.0",
    "dotenv": "16.4.7",
    "fetch-cookie": "3.1.0",
    "googleapis": "^178.1.1",
    "pg": "^8.23.0",
    "playwright-core": "^1.63.0",
    "tough-cookie": "5.1.2"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  }
}
